{
  "name": "chat-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts && node scripts/rename-single.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "desktop:run": "npm run build:single && electron .",
    "build:desktop": "npm run build:single && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.lordhussnain.chatviewer",
    "productName": "Chat Viewer",
    "copyright": "Chat Viewer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-single/chat-viewer.html",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Chat Viewer",
      "uninstallDisplayName": "Chat Viewer"
    },
    "portable": {
      "artifactName": "ChatViewer-Portable-${version}.exe"
    }
  }
}
