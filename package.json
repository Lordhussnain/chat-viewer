{
  "name": "chat-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts && node scripts/rename-single.mjs",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
